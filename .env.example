# Optional private GitHub downloads (Contents API; classic PAT needs repo scope)
GITHUB_TOKEN=
# Optional GitLab support (gitlab.com + self-hosted via GITLAB_BASE_URL)
GITLAB_TOKEN=
GITLAB_BASE_URL=

# On-demand static analysis (all file types)
STATIC_ANALYSIS_ENABLED=true
STATIC_ANALYSIS_TIMEOUT=180
STATIC_ANALYSIS_DAILY_LIMIT=25
STATIC_ANALYSIS_BURST_LIMIT=5
STATIC_ANALYSIS_R2_TIMEOUT=120
R2_BINARY=r2
MAX_CACHED_FILE_BYTES=50000000

# v4 platform (Render web + worker, persistent disk at PLATFORM_DATA_DIR)
PLATFORM_DATA_DIR=/var/data
PLATFORM_DB_PATH=
WORKER_ENABLED=true
WORKER_INLINE=true
DEDICATED_WORKER=false
WORKER_POLL_SECONDS=2
AUTO_DEEP_ANALYSIS=false
WEBHOOK_URL=
WEBHOOK_SECRET=
YARA_RULES_DIR=

# Optional paid LLM narrative — disabled by default (deterministic semantic engine is primary)
SEMANTIC_LLM_ENABLED=false
SEMANTIC_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
SEMANTIC_LLM_TIMEOUT=45
SEMANTIC_LLM_MAX_CODE_CHARS=12000

ABUSECH_API_KEY=

THREATFOX_ENABLED=true
MALWAREBAZAAR_ENABLED=true
URLHAUS_ENABLED=true
FEODO_ENABLED=true
SSLBL_ENABLED=true

THREATFOX_LOOKUP_LIMIT=75
THREATFOX_TIMEOUT=18
MALWAREBAZAAR_LOOKUP_LIMIT=250
MALWAREBAZAAR_TIMEOUT=18
URLHAUS_LOOKUP_LIMIT=75
URLHAUS_TIMEOUT=18
FEODO_TIMEOUT=20
SSLBL_TIMEOUT=20

MAX_DOWNLOAD_BYTES=50000000
MAX_EXTRACT_DEPTH=3
MAX_EXTRACT_FILES=250
MAX_EXTRACT_BYTES=100000000

# Safety architecture
# local_dev = samples are downloaded/extracted on this backend machine. Use only in a VM/lab.
# server = production mode where users submit URLs and receive metadata only; backend worker handles samples.
ANALYSIS_MODE=local_dev
SERVER_ANALYSIS_MODE=false
JOB_TTL_HOURS=24

# Public abuse / quota protection
PUBLIC_MODE=true
RATE_LIMIT_ENABLED=true
FREE_DAILY_ANALYSIS_LIMIT=10
BURST_ANALYSIS_LIMIT_PER_MINUTE=3
MAX_RUNNING_JOBS_PER_IP=2
MAX_INPUT_URL_LENGTH=2048
# Only trust X-Forwarded-For / X-Real-IP when behind a known reverse proxy
TRUST_PROXY=false
# Optional: send this value as x-admin-bypass-token for trusted admin/internal testing
ADMIN_BYPASS_TOKEN=

# Repo hunt (JsOutProx-style scanner → SMTP)
# --- Set these on the Render Dashboard for service `repotriage-repo-hunt` ---
# The app reads them at runtime via RepoHuntConfig.from_env() / os.environ.
REPO_HUNT_ENABLED=true
REPO_HUNT_LOOP=true
REPO_HUNT_INTERVAL_SECONDS=300
REPO_HUNT_TO_EMAIL=
REPO_HUNT_GITHUB_ORGS=
REPO_HUNT_GITHUB_USERS=
REPO_HUNT_SEARCH_QUERY=
REPO_HUNT_WEBHOOK_SECRET=
REPO_HUNT_VT_CONFIRM=true
REPO_HUNT_WU_ENABLED=true
# Financial/WU repo watch: last N commits → top M newest files → VT
REPO_HUNT_REPO_WATCH_COMMITS=10
REPO_HUNT_REPO_WATCH_NEWEST_FILES=5
# Optional CSV of GitHub repo search queries (if unset, built-in WU/financial defaults apply)
# REPO_HUNT_WU_REPO_QUERIES=mtcn in:name,description NOT mtcnn,westernunion in:name,description,wu_receipt in:name,description
# REPO_HUNT_EXTRA_SEARCH_QUERIES=
# Optional CSV of GitLab project search terms (if unset, built-in WU/financial defaults apply)
# REPO_HUNT_GITLAB_SEARCH_TERMS=wu_receipt,westernunion,moneygram,remittance
GITLAB_TOKEN=
GITLAB_BASE_URL=
ANALYSIS_ALERT_EMAIL=true
VT_API_KEY=
VT_LIVEHUNT_WU_RULE_ID=20744291635
VT_LIVEHUNT_RULE_ID=
GITHUB_TOKEN=
REPOTRIAGE_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true

# Security / ops (safe defaults for public deployments)
# Sync /api/analyze is disabled unless explicitly enabled (jobs API remains the supported path)
ALLOW_SYNC_ANALYZE=false
# Delete quarantine files after each analysis completes (set true for local debugging)
KEEP_QUARANTINE=false
# Parallel VirusTotal child lookups
VT_CONCURRENT_LIMIT=5

# Optional future object storage / R2 settings
STORAGE_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT_URL=

# TLS for outbound httpx (GitHub/VT/AbuseCH). Prefer certifi CA bundle.
HTTPX_PREFER_CERTIFI=true
# HTTPX_VERIFY=true
# HTTPX_VERIFY=false   # emergency only
